# Leave unset for local development — Vite's dev server proxies /api and /socket.io to
# http://localhost:4000 (see vite.config.ts), so relative paths just work.
#
# Set this when the API is deployed to a different origin than the client (e.g. client on
# Vercel, API on Render): the bare origin, no trailing slash, no /api suffix.
# VITE_API_URL=https://your-api.onrender.com
