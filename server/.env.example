# Optional. If unset, the server auto-manages a local MongoDB via mongodb-memory-server
# (zero setup, data persisted to server/.mongo-data). Set this to point at a real MongoDB
# instance instead — e.g. a local `mongod` or an Atlas connection string.
# MONGODB_URI=mongodb://127.0.0.1:27017/shiftsync

# Signs the JWTs issued at login. Change this for anything beyond local development.
JWT_SECRET=dev-secret-not-for-production

# Port the API listens on.
PORT=4000

# Origin allowed to connect via CORS / Socket.IO. Set to your deployed client's URL in production.
CLIENT_ORIGIN=http://localhost:5173
